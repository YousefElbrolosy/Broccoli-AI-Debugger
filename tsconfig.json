{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"noEmit": true, /* type-check only; esbuild.mjs produces out/extension.js */
		"skipLibCheck": true, /* MCP SDK d.ts files need DOM types / resolution-mode we don't use */
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true /* enable all strict type-checking options */
	},
	"include": [
		"src/**/*.ts"
	]
}
